{
  "name": "greyhound-dialog",
  "author": "Ilya",
  "version": "1.3.0",
  "keywords": ["pebble-app", "watchface"],
  "private": true,
  "dependencies": {"@rebble/clay": "^1.0.4"},
  "pebble": {
    "displayName": "Greyhound Dialog",
    "uuid": "29d6ff43-25ac-4e9f-9e70-d1d7cf4300f2",
