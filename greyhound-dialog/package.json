    "messageKeys": [
      "Temperature", "RequestWeather", "BackgroundColor", "BubbleColor", "BorderColor", "TextColor", "AccentColor", "StatusColor", "Use24h", "AutoLocation", "ManualLocation", "PhoneBattery"
    ],
    "resources": {"media": [
      {"type":"font","name":"FONT_DIALOG_15","file":"fonts/dialog-mono-cyr.ttf","compatibility":"2.7","characterRegex":"[А-Яа-яЁёA-Za-z0-9:,.!?°%() -]"},
      {"type":"font","name":"FONT_DIALOG_BOLD_17","file":"fonts/dialog-mono-cyr.ttf","compatibility":"2.7","characterRegex":"[А-Яа-яЁёA-Za-z0-9:,.!?°%() -]"},
      {"type":"bitmap","name":"IMAGE_GREYHOUND","file":"images/greyhound_status.png"}
    ]}
  }
}
